@baseUrl = http://localhost:5210

### Get all products
GET {{baseUrl}}/api/products

### Get one product
GET {{baseUrl}}/api/products/1

### Search products
GET {{baseUrl}}/api/products?search=lap

### Create a product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "title": "Keyboard",
  "price": 90,
  "categoryId": 1
}

### Create a product in a category that does not exist
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "title": "Ghost",
  "price": 10,
  "categoryId": 999
}

### Update a product
PUT {{baseUrl}}/api/products/1
Content-Type: application/json

{
  "title": "Fancy Laptop",
  "price": 2400,
  "categoryId": 1
}

### Delete a product
DELETE {{baseUrl}}/api/products/4